#!/bin/sh
# commit-msg hook - commit message policy.
# Installed by GitHelper (C:\Camtek\Sources\Tools\GitHelper); enable per clone with
#   git config core.hooksPath .githooks
#
#   line 1         subject, max MAX_SUBJECT chars
#   other lines    max MAX_BODY_LINES non-blank lines
#   whole message  max MAX_CHARS chars (newlines included)
#   must contain   REQUIRED_TAG followed by a value, e.g. "Commit Type: Bugfix"

MAX_SUBJECT=72
MAX_BODY_LINES=36   # GitHelper: body up to 30 lines + up to 6 field lines
MAX_CHARS=2200
REQUIRED_TAG="Commit Type:"

awk -v maxs="$MAX_SUBJECT" -v maxb="$MAX_BODY_LINES" -v maxc="$MAX_CHARS" -v tag="$REQUIRED_TAG" '
/^# -+ >8 -+$/ { scissors = 1 }                  # "git commit -v" scissors line
scissors       { next }
/^#/           { next }                          # git comment lines
{ sub(/[ \t\r]+$/, ""); line[++n] = $0 }         # trim trailing spaces / CR
END {
  while (n > 0 && line[n] == "") n--             # drop trailing blank lines
  if (n == 0) { print "Commit message is empty."; exit 1 }

  err = 0
  chars = -1; body = 0; found = 0; hasval = 0
  for (i = 1; i <= n; i++) {
    chars += length(line[i]) + 1
    if (i > 1 && line[i] != "") body++
    p = index(line[i], tag)
    if (p > 0) {
      found = 1
      if (substr(line[i], p + length(tag)) ~ /[^ \t]/) hasval = 1
    }
  }

  if (length(line[1]) > maxs) {
    printf "Subject line is %d chars (max %d).\n", length(line[1]), maxs; err = 1
  }
  if (body > maxb) {
    printf "Message has %d lines after the subject (max %d).\n", body, maxb; err = 1
  }
  if (chars > maxc) {
    printf "Message is %d chars (max %d).\n", chars, maxc; err = 1
  }
  if (!found) {
    printf "Message must contain \"%s\" (e.g. \"%s Bugfix\").\n", tag, tag; err = 1
  } else if (!hasval) {
    printf "\"%s\" needs a value after it (e.g. \"%s Bugfix\").\n", tag, tag; err = 1
  }
  exit err
}' "$1" 1>&2 || {
  echo "" >&2
  echo "Commit rejected - fix the commit message and try again." >&2
  exit 1
}
