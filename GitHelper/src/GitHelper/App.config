<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <!-- No DpiAwareness key on purpose: the manifest declares the application
       DPI-unaware, so there is nothing for WinForms to scale. -->
</configuration>
